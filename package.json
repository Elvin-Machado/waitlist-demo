{
  "name": "kawsweb2",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.2",
  "workspaces": [ "waitlist-app","functions"],
  "engines": { "bun": ">=1.3.0", "node": ">=20.9.0" },
  "scripts": {
    "dev": "bun run --parallel --filter user-app --filter admin-app --filter waitlist-app dev",
    "dev:user": "bun run --cwd user-app dev",
    "dev:admin": "bun run --cwd admin-app dev",
    "dev:waitlist": "bun run --cwd waitlist-app dev",
    "build": "bun run build:user && bun run build:admin && bun run build:waitlist",
    "build:user": "bun run --cwd user-app build",
    "build:admin": "bun run --cwd admin-app build",
    "build:waitlist": "bun run --cwd waitlist-app build",
    "start": "bun run --parallel --filter user-app --filter admin-app --filter waitlist-app start",
    "start:user": "bun run --cwd user-app start",
    "start:admin": "bun run --cwd admin-app start",
    "start:waitlist": "bun run --cwd waitlist-app start",
    "lint": "bun run --filter user-app --filter admin-app --filter waitlist-app --filter functions lint",
    "test": "bun run test:unit",
    "test:unit": "bun --no-env-file test tests/unit functions/test",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0"
  }
}
